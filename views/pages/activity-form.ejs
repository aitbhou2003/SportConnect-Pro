<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= editMode ? "Edit Activity" : "Add Activity" %>
        - SportConnect Pro
    </title>
</head>

<body>

    <h1>SportConnect Pro</h1>

    <nav>
        <a href="/activities">
            Activities
        </a>

        |

        <a href="/members">
            Members
        </a>
    </nav>

    <hr>

    <% if (editMode) { %>

        <h2>Edit Activity</h2>

    <% } else { %>

        <h2>Add Activity</h2>

    <% } %>


    <form
        method="POST"
        action="<%= editMode
            ? `/activities/${activity.id}/update`
            : `/activities`
        %>"
    >

        <!-- ========================================= -->
        <!-- Activity name -->
        <!-- ========================================= -->

        <div>

            <label for="name">
                Name:
            </label>

            <input
                type="text"
                id="name"
                name="name"
                value="<%= activity ? activity.name : '' %>"
                required
            >

        </div>

        <br>


        <!-- ========================================= -->
        <!-- Base price -->
        <!-- ========================================= -->

        <div>

            <label for="base_price">
                Base price:
            </label>

            <input
                type="number"
                id="base_price"
                name="base_price"
                value="<%= activity ? activity.base_price : '' %>"
                min="0"
                step="0.01"
                required
            >

            €

        </div>

        <br>


        <!-- ========================================= -->
        <!-- Maximum capacity -->
        <!-- ========================================= -->

        <div>

            <label for="max_capacity">
                Maximum capacity:
            </label>

            <input
                type="number"
                id="max_capacity"
                name="max_capacity"
                value="<%= activity ? activity.max_capacity : '' %>"
                min="1"
                required
            >

        </div>

        <br>


        <!-- ========================================= -->
        <!-- Age category -->
        <!-- ========================================= -->

        <div>

            <label for="age_category">
                Age category:
            </label>

            <input
                type="text"
                id="age_category"
                name="age_category"
                value="<%= activity ? activity.age_category : '' %>"
                required
            >

        </div>

        <br>


        <!-- ========================================= -->
        <!-- Association -->
        <!-- ========================================= -->

        <div>

            <label for="association_id">
                Association:
            </label>

            <select
                id="association_id"
                name="association_id"
                required
            >

                <option value="">
                    -- Select an association --
                </option>

                <% associations.forEach((association) => { %>

                    <option
                        value="<%= association.id %>"
                        <%= activity &&
                            Number(activity.association_id) === Number(association.id)
                            ? "selected"
                            : ""
                        %>
                    >
                        <%= association.name %>
                    </option>

                <% }) %>

            </select>

        </div>

        <br>


        <!-- ========================================= -->
        <!-- Facility -->
        <!-- ========================================= -->

        <div>

            <label for="facility_id">
                Facility:
            </label>

            <select
                id="facility_id"
                name="facility_id"
                required
            >

                <option value="">
                    -- Select a facility --
                </option>

                <% facilities.forEach((facility) => { %>

                    <option
                        value="<%= facility.id %>"
                        <%= activity &&
                            Number(activity.facility_id) === Number(facility.id)
                            ? "selected"
                            : ""
                        %>
                    >
                        <%= facility.name %>
                    </option>

                <% }) %>

            </select>

        </div>

        <br>


        <!-- ========================================= -->
        <!-- Weekday -->
        <!-- ========================================= -->

        <div>

            <label for="weekday">
                Weekday:
            </label>

            <select
                id="weekday"
                name="weekday"
                required
            >

                <option value="">
                    -- Select a day --
                </option>

                <option
                    value="1"
                    <%= activity &&
                        Number(activity.weekday) === 1
                        ? "selected"
                        : ""
                    %>
                >
                    Monday
                </option>

                <option
                    value="2"
                    <%= activity &&
                        Number(activity.weekday) === 2
                        ? "selected"
                        : ""
                    %>
                >
                    Tuesday
                </option>

                <option
                    value="3"
                    <%= activity &&
                        Number(activity.weekday) === 3
                        ? "selected"
                        : ""
                    %>
                >
                    Wednesday
                </option>

                <option
                    value="4"
                    <%= activity &&
                        Number(activity.weekday) === 4
                        ? "selected"
                        : ""
                    %>
                >
                    Thursday
                </option>

                <option
                    value="5"
                    <%= activity &&
                        Number(activity.weekday) === 5
                        ? "selected"
                        : ""
                    %>
                >
                    Friday
                </option>

                <option
                    value="6"
                    <%= activity &&
                        Number(activity.weekday) === 6
                        ? "selected"
                        : ""
                    %>
                >
                    Saturday
                </option>

                <option
                    value="7"
                    <%= activity &&
                        Number(activity.weekday) === 7
                        ? "selected"
                        : ""
                    %>
                >
                    Sunday
                </option>

            </select>

        </div>

        <br>


        <!-- ========================================= -->
        <!-- Start time -->
        <!-- ========================================= -->

        <div>

            <label for="start_time">
                Start time:
            </label>

            <input
                type="time"
                id="start_time"
                name="start_time"
                value="<%= activity ? activity.start_time : '' %>"
                required
            >

        </div>

        <br>


        <!-- ========================================= -->
        <!-- End time -->
        <!-- ========================================= -->

        <div>

            <label for="end_time">
                End time:
            </label>

            <input
                type="time"
                id="end_time"
                name="end_time"
                value="<%= activity ? activity.end_time : '' %>"
                required
            >

        </div>

        <br>


        <!-- ========================================= -->
        <!-- Subzone -->
        <!-- ========================================= -->

        <div>

            <label for="subzone">
                Subzone:
            </label>

            <input
                type="text"
                id="subzone"
                name="subzone"
                value="<%= activity ? (activity.subzone || '') : '' %>"
                placeholder="Example: Terrain A"
            >

            <p>
                Leave empty if the activity uses the whole facility.
            </p>

        </div>

        <br>


        <!-- ========================================= -->
        <!-- Submit -->
        <!-- ========================================= -->

        <button type="submit">

            <%= editMode
                ? "Update Activity"
                : "Create Activity"
            %>

        </button>

    </form>

    <hr>


    <!-- ========================================= -->
    <!-- Cancel -->
    <!-- ========================================= -->

    <p>

        <a href="/activities">
            Cancel
        </a>

    </p>

</body>

</html>