<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= activity.name %> - SportConnect Pro
    </title>
</head>

<body>

    <h1>SportConnect Pro</h1>

    <nav>
        <a href="/activities">
            ← Back to activities
        </a>
    </nav>

    <hr>

    <h2>
        <%= activity.name %>
    </h2>

    <p>
        <strong>Price:</strong>
        <%= activity.base_price %> €
    </p>

    <p>
        <strong>Maximum capacity:</strong>
        <%= activity.max_capacity %>
    </p>

    <p>
        <strong>Age category:</strong>
        <%= activity.age_category %>
    </p>

    <p>
        <strong>Association:</strong>
        <%= activity.association_name || "Unknown" %>
    </p>

    <p>
        <strong>Facility:</strong>
        <%= activity.facility_name || "Unknown" %>
    </p>

    <p>
        <strong>Weekday:</strong>
        <%= activity.weekday %>
    </p>

    <p>
        <strong>Start:</strong>
        <%= activity.start_time %>
    </p>

    <p>
        <strong>End:</strong>
        <%= activity.end_time %>
    </p>

    <p>
        <strong>Subzone:</strong>
        <%= activity.subzone || "Whole facility" %>
    </p>

    <hr>

    <h3>Actions</h3>

    <p>
        <a href="/activities/<%= activity.id %>/edit">
            Edit activity
        </a>
    </p>

    <form
        method="POST"
        action="/activities/<%= activity.id %>/delete"
    >
        <button type="submit">
            Delete activity
        </button>
    </form>

    <hr>

    <h3>Registration</h3>

    <p>
        <a href="/checkout/<%= activity.id %>">
            Register for this activity
        </a>
    </p>

</body>

</html>