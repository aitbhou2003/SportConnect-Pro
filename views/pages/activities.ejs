<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>

    <h1>SportConnect Pro</h1>

    <nav>
        <a href="/activities">Activities</a>
        |
        <a href="/members">Members</a>
    </nav>

    <hr>

    <h2>Activities</h2>

    <p>
        <a href="/activities/new">
            + Add activity
        </a>
    </p>

    <hr>
    <% const daysMap={ 1: 'Monday' , 2: 'Tuesday' , 3: 'Wednesday' , 4: 'Thursday' , 5: 'Friday' , 6: 'Saturday' ,
        7: 'Sunday' }; %>

        <% if (activities.length===0) { %>

            <p>
                No activity found.
            </p>

            <% } else { %>

                <% activities.forEach((activity)=> { %>

                    <article>
                        <h3>
                            <%= activity.name %>
                        </h3>

                        <p>
                            Base price :
                            <%= activity.base_price %>
                        </p>

                        <p>
                            Max capacity :
                            <%= activity.max_capacity %>
                        </p>

                        <p>
                            Age category :
                            <%= activity.age_category %>
                        </p>

                        <p>
                            Association :
                            <%= activity.association_name %>
                        </p>

                        <p>
                            Facility :
                            <%= activity.facility_name %>
                        </p>

                        <p>
                            Week day : 
                            <%= daysMap[activity.weekday] %>
                        </p>

                        <p>
                            Start time : 
                            <%= activity.start_time %>
                        </p>

                         <p>
                            End time : 
                            <%= activity.end_time %>
                        </p>

                         <p>
                            Subzone : 
                            <%= activity.subzone || "Whole facility" %>
                        </p>
                        



                        <a href="/activities/<%= activity.id %>">
                            View details
                        </a>

                        |

                        <a href="/activities/<%= activity.id %>/edit">
                            Edit
                        </a>

                        |


                        <form method="POST" action="/activities/<%= activity.id %>/delete" style="display: inline;">

                            <button type="submit">
                                Delete
                            </button>

                        </form>

                    </article>
                    <hr>


                    <% }) %>

                        <% } %>








                            <!-- <% activities.forEach((activity) => { %>

            <div><%= activity.name %></div>


        <% }) %> -->


</body>

</html>